# Copy to .env and fill in. .env is gitignored -- never commit it.
# Every value can also come from the real environment, which wins over .env.
# After filling it in:  python scripts/doctor.py

# --- MLflow AI Gateway: every model call goes here -------------------------
# The app knows endpoint NAMES only. Which model serves an endpoint (e.g. a
# Databricks serving endpoint) and its credentials are configured in MLflow.
MLFLOW_GATEWAY_URL=http://127.0.0.1:5050
# MLFLOW_GATEWAY_TOKEN=            # only if the gateway has auth on
GATEWAY_ENDPOINT=ze-ai             # default endpoint for every role
GATEWAY_JUDGE_ENDPOINT=ze-ai-judge # the eval judge, usually a lighter model
# GATEWAY_PLANNER_ENDPOINT=        # optional per-role overrides, so budgets
# GATEWAY_SKILL_ENDPOINT=          # can be scoped per role
# GATEWAY_PROSE_ENDPOINT=
# MODEL_REQUESTS_PER_SECOND=0      # MLflow caps spend, not rate; 0 = no limit

# --- Specs: where tools come from -----------------------------------------
# The spec folder (services/<name>/openapi.json). Used by `tool_spec.py sync`
# only -- the service runs on the committed snapshot in specs/.
# In this monorepo it is the sibling folder:
SPEC_REPO_PATH=../ze-api-specs
# If the specs ever move to their own git repo, use these instead:
# SPEC_REPO_URL=https://github.com/YOUR-ORG/ze-api-specs.git
# SPEC_REPO_REF=main

# --- Services: one base URL per service tools.yaml uses ---------------------
# SERVICE_<NAME>_URL, NAME = the spec repo folder, upper-cased, - -> _
SERVICE_CUSTOMERS_URL=http://127.0.0.1:9101
SERVICE_ORDERS_URL=http://127.0.0.1:9102
# SERVICE_TIMEOUT_S=30

# Every service call carries the END USER's own bearer token (the API takes it
# from the caller's Authorization header). The CLI and evals have no end user,
# so they use this. Never set it on a deployed server.
# ZE_DEV_TOKEN=

# Pin "today" for relative dates (demos, evals over fixed data). Blank = today.
# AS_OF_DATE=2026-10-01

# --- Langfuse: tracing, prompt management, evals ---------------------------
# Leave the keys unset and Langfuse is off entirely.
# LANGFUSE_HOST=https://langfuse.your-org.internal
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_ENVIRONMENT=dev         # filter traces per deployment
# Serve prompts from Langfuse (editable in its UI, no deploy). Seed once with
# `python scripts/prompts.py push`; repo files stay the fallback.
# LANGFUSE_PROMPTS=true
# LANGFUSE_PROMPT_LABEL=production
# LANGFUSE_PROMPT_PREFIX=ze-ai/    # namespace prompts + datasets in a shared project

# --- Server ---------------------------------------------------------------
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ALLOW_ORIGINS=["https://your-frontend.internal"]
