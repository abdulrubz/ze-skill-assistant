{
  "openapi": "3.1.0",
  "info": {
    "title": "orders",
    "description": "Orders and order lines, with per-customer and ranking reports.",
    "version": "1.0.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "summary": "List orders, newest first",
        "description": "Orders matching every filter, newest first, without their lines (use\ngetOrder for lines).\n\n**Returns:** a list of orders with id, date, status, currency and total.",
        "operationId": "listOrders",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "customer_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this customer's orders",
              "title": "Customer Id"
            },
            "description": "Only this customer's orders"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "placed",
                    "paid",
                    "shipped",
                    "delivered",
                    "cancelled",
                    "refunded"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only orders in this status",
              "title": "Status"
            },
            "description": "Only orders in this status"
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Orders on or after this date (YYYY-MM-DD)",
              "title": "Since"
            },
            "description": "Orders on or after this date (YYYY-MM-DD)"
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Orders on or before this date (YYYY-MM-DD)",
              "title": "Until"
            },
            "description": "Orders on or before this date (YYYY-MM-DD)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Maximum orders to return",
              "default": 50,
              "title": "Limit"
            },
            "description": "Maximum orders to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderSummary"
                  },
                  "title": "Response Listorders"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "summary": "One order with its lines",
        "description": "A single order including every line.\n\n**Returns:** the order's id, customer id, date, status, currency, total and\nlines (sku, description, quantity, unit price, amount). 404 if not found.",
        "operationId": "getOrder",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Order id, e.g. ORD-10001",
              "title": "Order Id"
            },
            "description": "Order id, e.g. ORD-10001"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{customer_id}/order-summary": {
      "get": {
        "summary": "Order totals for one customer",
        "description": "Aggregates over one customer's orders. Revenue counts only orders that\nwere not cancelled or refunded, and is reported per currency.\n\n**Returns:** order counts, revenue per currency, open orders and the first\nand last order dates.",
        "operationId": "getCustomerOrderSummary",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Customer id, e.g. CUST-1001",
              "title": "Customer Id"
            },
            "description": "Customer id, e.g. CUST-1001"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerOrderSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports/top-customers": {
      "get": {
        "summary": "Customers ranked by spend",
        "description": "Customers ranked by revenue from counted orders (not cancelled or\nrefunded) in one currency.\n\n**Returns:** rank, customer id, currency, total and order count. Customer\nids only -- look names up in the customers service.",
        "operationId": "getTopCustomers",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "currency",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Rank within this currency (USD or EUR); totals are never mixed across currencies",
              "title": "Currency"
            },
            "description": "Rank within this currency (USD or EUR); totals are never mixed across currencies"
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only orders on or after this date (YYYY-MM-DD)",
              "title": "Since"
            },
            "description": "Only orders on or after this date (YYYY-MM-DD)"
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only orders on or before this date (YYYY-MM-DD)",
              "title": "Until"
            },
            "description": "Only orders on or before this date (YYYY-MM-DD)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "How many customers to return",
              "default": 10,
              "title": "Limit"
            },
            "description": "How many customers to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TopCustomer"
                  },
                  "title": "Response Gettopcustomers"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/cancel": {
      "post": {
        "summary": "Cancel an order",
        "description": "Cancels an order that has not shipped yet. A WRITE: ze-ai lists it as\navailable but never exposes it to a model (its tool layer is read-only).\n\n**Returns:** the cancelled order. 409 if it has already shipped.",
        "operationId": "cancelOrder",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Order id to cancel",
              "title": "Order Id"
            },
            "description": "Order id to cancel"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrencyTotal": {
        "properties": {
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "ISO currency"
          },
          "total": {
            "type": "number",
            "title": "Total",
            "description": "Total of counted orders in this currency"
          },
          "order_count": {
            "type": "integer",
            "title": "Order Count",
            "description": "Counted orders in this currency"
          }
        },
        "type": "object",
        "required": [
          "currency",
          "total",
          "order_count"
        ],
        "title": "CurrencyTotal"
      },
      "CustomerOrderSummary": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id",
            "description": "Customer id"
          },
          "order_count": {
            "type": "integer",
            "title": "Order Count",
            "description": "All orders, any status"
          },
          "counted_order_count": {
            "type": "integer",
            "title": "Counted Order Count",
            "description": "Orders that count as revenue (not cancelled or refunded)"
          },
          "totals": {
            "items": {
              "$ref": "#/components/schemas/CurrencyTotal"
            },
            "type": "array",
            "title": "Totals",
            "description": "Revenue per currency, counted orders only"
          },
          "open_orders": {
            "type": "integer",
            "title": "Open Orders",
            "description": "Orders placed or paid but not yet shipped"
          },
          "first_order_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Order Date",
            "description": "Date of the first order, null if none"
          },
          "last_order_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Order Date",
            "description": "Date of the most recent order, null if none"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "order_count",
          "counted_order_count",
          "totals",
          "open_orders",
          "first_order_date",
          "last_order_date"
        ],
        "title": "CustomerOrderSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Order": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id",
            "description": "Order id, e.g. ORD-10001"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id",
            "description": "Customer id (resolve names via the customers service)"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "Order date (YYYY-MM-DD)"
          },
          "status": {
            "type": "string",
            "enum": [
              "placed",
              "paid",
              "shipped",
              "delivered",
              "cancelled",
              "refunded"
            ],
            "title": "Status",
            "description": "placed, paid, shipped, delivered, cancelled or refunded"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "ISO currency of the order"
          },
          "total": {
            "type": "number",
            "title": "Total",
            "description": "Sum of line amounts, in the order currency"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "type": "array",
            "title": "Lines",
            "description": "The order lines"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "customer_id",
          "created_at",
          "status",
          "currency",
          "total",
          "lines"
        ],
        "title": "Order"
      },
      "OrderLine": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku",
            "description": "Product SKU"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Product name"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity",
            "description": "Units ordered"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price",
            "description": "Price per unit in the order currency"
          },
          "amount": {
            "type": "number",
            "title": "Amount",
            "description": "quantity x unit_price"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "description",
          "quantity",
          "unit_price",
          "amount"
        ],
        "title": "OrderLine"
      },
      "OrderSummary": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id",
            "description": "Order id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "Order date (YYYY-MM-DD)"
          },
          "status": {
            "type": "string",
            "enum": [
              "placed",
              "paid",
              "shipped",
              "delivered",
              "cancelled",
              "refunded"
            ],
            "title": "Status",
            "description": "Order status"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "ISO currency of the order"
          },
          "total": {
            "type": "number",
            "title": "Total",
            "description": "Order total in its currency"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "created_at",
          "status",
          "currency",
          "total"
        ],
        "title": "OrderSummary"
      },
      "TopCustomer": {
        "properties": {
          "rank": {
            "type": "integer",
            "title": "Rank",
            "description": "1 = highest spend"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id",
            "description": "Customer id (names come from the customers service)"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "Currency of the total"
          },
          "total": {
            "type": "number",
            "title": "Total",
            "description": "Revenue from counted orders in the window"
          },
          "order_count": {
            "type": "integer",
            "title": "Order Count",
            "description": "Counted orders in the window"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "customer_id",
          "currency",
          "total",
          "order_count"
        ],
        "title": "TopCustomer"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "The end user's JWT, forwarded unchanged by ze-ai",
        "scheme": "bearer"
      }
    }
  }
}
